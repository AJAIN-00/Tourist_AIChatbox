# ============================================================
# Tamil Nadu Smart Tourist Guide — Environment Configuration
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control!
# ============================================================

# Flask session encryption key — use a long, random string
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-key-change-this

# FLASK_ENV controls production hardening (e.g. Secure cookies)
# Set to "production" in live environments, leave empty in dev
FLASK_ENV=

# Set to "true" to enable Flask debug mode (NEVER enable in production)
FLASK_DEBUG=false

# Default admin password — set this before first boot.
# After first boot the admin account is created and this variable is ignored.
# If unset, a random secure password is generated and printed once to stdout.
ADMIN_DEFAULT_PASSWORD=

# Groq AI API Key (Free — get yours at https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# OpenWeatherMap API Key
OPENWEATHERMAP_API_KEY=your_openweathermap_api_key_here

# Google Maps Embed API Key (Optional; falls back to free embed if blank)
GOOGLE_MAPS_API_KEY=

# LibreTranslate URL (Defaults to standard public fallback)
LIBRETRANSLATE_URL=https://libretranslate.de
LIBRETRANSLATE_KEY=
